---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhotoGrid from "../components/photography/PhotoGrid.astro";
import { getPhotos } from "../utils/photos";

const photos = await getPhotos();
---

<BaseLayout
  title="Photography — Sam Young"
  description="A gallery of photography by Sam Young."
>
  <div class="region wrapper flow">
    <h1>Photography</h1>
    <p>Some photos that I really like from trips over the years.</p>
    <a href="/collections/" class="button" data-button-variant="border">Browse by collection</a>

    <PhotoGrid photos={photos} fallbackLabel="the gallery" />
  </div>

  <div class="region"></div>
</BaseLayout>
