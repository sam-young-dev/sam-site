---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
import ExpandButton from "../../components/core/ExpandButton.astro";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} | Projects | Sam Young`}
  description={project.summary}
>
  <div class="wrapper region">
    <a href="/projects/" class="project-detail__back">&larr; Back to projects</a>

    <header class="project-detail__header">
      <h1>{project.title}</h1>
      <p class="project-detail__summary">{project.summary}</p>

      <dl class="project-detail__meta">
        <div class="project-detail__meta-item">
          <dt>Year</dt>
          <dd>{project.year}</dd>
        </div>
        <div class="project-detail__meta-item">
          <dt>Stack</dt>
          <dd>
            <ul class="project-detail__stack not-prose">
              {project.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </dd>
        </div>
        <div class="project-detail__meta-item project-detail__meta-item--full">
          <dt>My role</dt>
          <dd>
            <ul class="project-detail__responsibilities">
              {project.responsibilities.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>

      <div class="project-detail__links">
        {project.links.live && (
          <a
            class="button"
            href={project.links.live}
            target="_blank"
            rel="noopener noreferrer"
          >
            View live site
          </a>
        )}
        {project.links.repo && (
          <a
            class="button"
            data-button-variant="secondary"
            href={project.links.repo}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              class="project-detail__github-icon"
              viewBox="0 0 16 16"
              width="16"
              height="16"
              aria-hidden="true"
              fill="currentColor"
            >
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
            </svg>
            View source
          </a>
        )}
      </div>
    </header>

    <div class="project-detail__content flow">
      {project.content.map((block) =>
        block.type === "heading" ? (
          <h2 class="project-detail__heading">{block.text}</h2>
        ) : block.type === "text" ? (
          <div class="prose">
            <p set:html={block.html} />
          </div>
        ) : block.type === "gallery" ? (
          <figure class="project-detail__gallery-item project-detail__gallery">
            <div class="project-detail__gallery-grid">
              {block.images.map((image) => (
                <figure class="project-detail__gallery-cell">
                  <button type="button" class="project-detail__zoom" aria-label={`Expand image: ${image.alt}`}>
                    <Image
                      src={image.src}
                      widths={[500, 900, 1400, 2000]}
                      sizes="(min-width: 48rem) 80vw, 100vw"
                      format="avif"
                      quality={85}
                      alt={image.alt}
                      loading="lazy"
                      class="project-detail__gallery-image"
                      onload="this.classList.add('is-loaded')"
                    />
                  </button>
                  <div class="project-detail__gallery-meta">
                    {image.caption && (
                      <figcaption class="project-detail__gallery-caption">{image.caption}</figcaption>
                    )}
                    <ExpandButton decorative />
                  </div>
                </figure>
              ))}
            </div>
            {block.caption && (
              <figcaption class="project-detail__gallery-caption">{block.caption}</figcaption>
            )}
          </figure>
        ) : block.type === "placeholder" ? (
          <figure class="project-detail__gallery-item">
            <div class="project-detail__placeholder" role="img" aria-label={block.label}>
              <span>{block.label}</span>
            </div>
            {block.caption && (
              <figcaption class="project-detail__gallery-caption">{block.caption}</figcaption>
            )}
          </figure>
        ) : (
          <figure class="project-detail__gallery-item">
            <button type="button" class="project-detail__zoom" aria-label={`Expand image: ${block.image.alt}`}>
              <Image
                src={block.image.src}
                widths={[500, 900, 1400, 2000]}
                sizes="(min-width: 48rem) 44rem, 100vw"
                format="avif"
                quality={85}
                alt={block.image.alt}
                loading="lazy"
                class="project-detail__gallery-image"
                onload="this.classList.add('is-loaded')"
              />
            </button>
            <div class="project-detail__gallery-meta">
              {block.image.caption && (
                <figcaption class="project-detail__gallery-caption">{block.image.caption}</figcaption>
              )}
              <ExpandButton decorative />
            </div>
          </figure>
        )
      )}
      <p class="end-mark" aria-hidden="true">❦</p>
    </div>
  </div>

  <div class="region"></div>

  <dialog class="image-viewer" aria-label="Expanded image view">
    <button type="button" class="image-viewer__close" aria-label="Close expanded image">&times;</button>
    <img class="image-viewer__image" alt="" />
  </dialog>
</BaseLayout>

<script>
  // Delegated on document so it survives ClientRouter page swaps; the dialog
  // is looked up at click time since it's replaced on each navigation.
  function largestSource(img: HTMLImageElement) {
    const candidates = img.srcset.split(",").map((s) => s.trim().split(/\s+/));
    return candidates.length && candidates[candidates.length - 1][0]
      ? candidates[candidates.length - 1][0]
      : img.currentSrc || img.src;
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const dialog = document.querySelector<HTMLDialogElement>(".image-viewer");
    if (!dialog) return;

    const zoom = target.closest<HTMLButtonElement>(".project-detail__zoom, .expand-button");
    if (zoom) {
      const thumb = zoom.closest("figure")?.querySelector("img");
      const full = dialog.querySelector<HTMLImageElement>(".image-viewer__image");
      if (!thumb || !full) return;
      full.src = largestSource(thumb);
      full.alt = thumb.alt;
      dialog.showModal();
      return;
    }

    // Backdrop (the dialog element itself) or close button dismisses
    if (target === dialog || target.closest(".image-viewer__close")) {
      dialog.close();
    }
  });
</script>
