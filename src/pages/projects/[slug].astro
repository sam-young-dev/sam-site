---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projects } from "../../data/projects";
import ExpandButton from "../../components/core/ExpandButton.astro";
import ZoomStage from "../../components/core/ZoomStage.astro";

export async function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.title} | Projects | Sam Young`}
  description={project.summary}
>
  <div class="wrapper region">
    <a href="/projects/" class="project-detail__back link-underline press">&larr; Back to projects</a>

    <header class="project-detail__header">
      <h1>{project.title}</h1>
      <p class="project-detail__summary">{project.summary}</p>

      <dl class="project-detail__meta cluster">
        <div class="project-detail__meta-item">
          <dt>Year</dt>
          <dd>{project.year}</dd>
        </div>
        <div class="project-detail__meta-item">
          <dt>Stack</dt>
          <dd>
            <ul class="project-detail__stack cluster not-prose">
              {project.stack.map((tech) => (
                <li>{tech}</li>
              ))}
            </ul>
          </dd>
        </div>
        <div class="project-detail__meta-item" data-span="full">
          <dt>My role</dt>
          <dd>
            <ul class="project-detail__responsibilities flow">
              {project.responsibilities.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      </dl>

      <div class="project-detail__links cluster">
        {project.links.live && (
          <a
            class="button"
            href={project.links.live}
            target="_blank"
            rel="noopener noreferrer"
          >
            View live site
          </a>
        )}
        {project.links.repo && (
          <a
            class="button project-detail__repo"
            data-button-variant="secondary"
            href={project.links.repo}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg
              class="project-detail__github-icon"
              viewBox="0 0 16 16"
              width="16"
              height="16"
              aria-hidden="true"
              fill="currentColor"
            >
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
            </svg>
            View source
          </a>
        )}
      </div>
    </header>

    <div class="project-detail__content flow">
      {project.content.map((block) =>
        block.type === "heading" ? (
          <h2 class="project-detail__heading">{block.text}</h2>
        ) : block.type === "text" ? (
          <div class="project-detail__prose prose">
            <p set:html={block.html} />
          </div>
        ) : block.type === "gallery" ? (
          <figure class="gallery-item project-detail__gallery">
            <div class="gallery-grid grid-auto">
              {block.images.map((image) => (
                <figure class="gallery-cell">
                  <button type="button" class="gallery-zoom" aria-label={`Expand image: ${image.alt}`}>
                    <Image
                      src={image.src}
                      widths={[500, 900, 1400, 2000]}
                      sizes="(min-width: 48rem) 80vw, 100vw"
                      format="avif"
                      quality={85}
                      alt={image.alt}
                      loading="lazy"
                      class="gallery-image"
                      onload="this.dataset.state = 'loaded'"
                      onerror="this.dataset.state = 'error'"
                    />
                  </button>
                  <div class="gallery-meta repel">
                    {image.caption && (
                      <figcaption class="gallery-caption">{image.caption}</figcaption>
                    )}
                    <ExpandButton decorative />
                  </div>
                </figure>
              ))}
            </div>
            {block.caption && (
              <figcaption class="gallery-caption">{block.caption}</figcaption>
            )}
          </figure>
        ) : block.type === "video" ? (
          <figure class="gallery-item project-detail__gallery">
            <video
              class="gallery-video"
              src={block.src}
              poster={block.poster}
              width={block.width}
              height={block.height}
              style={`aspect-ratio: ${block.width} / ${block.height}`}
              aria-label={block.label}
              controls
              muted
              loop
              playsinline
              preload="none"
            ></video>
            {block.caption && (
              <figcaption class="gallery-caption">{block.caption}</figcaption>
            )}
          </figure>
        ) : block.type === "placeholder" ? (
          <figure class="gallery-item">
            <div class="gallery-placeholder" role="img" aria-label={block.label}>
              <span>{block.label}</span>
            </div>
            {block.caption && (
              <figcaption class="gallery-caption">{block.caption}</figcaption>
            )}
          </figure>
        ) : (
          <figure class="gallery-item">
            <button type="button" class="gallery-zoom" aria-label={`Expand image: ${block.image.alt}`}>
              <Image
                src={block.image.src}
                widths={[500, 900, 1400, 2000]}
                sizes="(min-width: 48rem) 44rem, 100vw"
                format="avif"
                quality={85}
                alt={block.image.alt}
                loading="lazy"
                class="gallery-image"
                onload="this.dataset.state = 'loaded'"
                onerror="this.dataset.state = 'error'"
              />
            </button>
            <div class="gallery-meta repel">
              {block.image.caption && (
                <figcaption class="gallery-caption">{block.image.caption}</figcaption>
              )}
              <ExpandButton decorative />
            </div>
          </figure>
        )
      )}
      <p class="end-mark" aria-hidden="true">❦</p>
    </div>
  </div>

  <div class="region"></div>

  <dialog class="image-viewer" aria-label="Expanded image view">
    <ZoomStage closeLabel="Close expanded image" nav />
  </dialog>
</BaseLayout>

<script>
  import { setupZoomStage } from "../../lib/zoom-stage.js";

  type Viewer = ReturnType<typeof setupZoomStage>;
  const viewers = new WeakMap<HTMLDialogElement, Viewer>();

  // The photos the viewer can step through: the other images in the same
  // gallery group, never ones further down the page in a different group
  let group: HTMLImageElement[] = [];
  let index = 0;

  function largestSource(img: HTMLImageElement) {
    const candidates = img.srcset.split(",").map((s) => s.trim().split(/\s+/));
    return candidates.length && candidates[candidates.length - 1][0]
      ? candidates[candidates.length - 1][0]
      : img.currentSrc || img.src;
  }

  function show(viewer: Viewer, thumb: HTMLImageElement) {
    const full = viewer.image as HTMLImageElement;
    viewer.reset();
    viewer.setNav({ prev: index > 0, next: index < group.length - 1 });
    // The browser keeps painting the previous image until the new one
    // arrives, so hide it until this one has loaded
    const src = largestSource(thumb);
    if (full.getAttribute("src") !== src || !full.complete) {
      full.dataset.state = "loading";
      full.onload = full.onerror = () => {
        full.dataset.state = "loaded";
        // Zoom bounds depend on the photo's real proportions; keep any zoom
        // the reader started while it loaded
        viewer.refresh();
      };
      full.src = src;
    }
    full.alt = thumb.alt;
  }

  // Set up once per dialog; ClientRouter swaps in a fresh one on each navigation
  function getViewer(dialog: HTMLDialogElement) {
    let viewer = viewers.get(dialog);
    if (viewer) return viewer;
    const stage = dialog.querySelector<HTMLElement>(".zoom-stage")!;
    const created = setupZoomStage(stage, {
      onClose: () => dialog.close(),
      onNavigate(direction) {
        const nextIndex = index + (direction === "next" ? 1 : -1);
        if (!group[nextIndex]) return;
        index = nextIndex;
        show(created, group[index]);
      },
    });
    dialog.addEventListener("close", () => created.close());
    viewers.set(dialog, created);
    return created;
  }

  // Delegated on document so it survives ClientRouter page swaps; the dialog
  // is looked up at click time since it's replaced on each navigation.
  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest(".gallery-zoom, .expand-button");
    const dialog = document.querySelector<HTMLDialogElement>(".image-viewer");
    if (!trigger || !dialog) return;

    const thumb = trigger.closest("figure")?.querySelector<HTMLImageElement>(".gallery-image");
    if (!thumb) return;
    const grid = thumb.closest(".gallery-grid");
    group = grid ? [...grid.querySelectorAll<HTMLImageElement>(".gallery-image")] : [thumb];
    index = Math.max(0, group.indexOf(thumb));

    show(getViewer(dialog), thumb);
    dialog.showModal();
    // showModal() would focus the stage, the first focusable element
    dialog.querySelector<HTMLButtonElement>('[data-action="close"]')?.focus();
  });
</script>
