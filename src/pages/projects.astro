---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/core/ProjectCard.astro";
import { projects } from "../data/projects";
---

<BaseLayout
  title="Projects | Sam Young"
  description="A showcase of software projects built by Sam Young."
>
  <div class="wrapper region prose prose-w-sm flow">
    <h1>Projects</h1>
    <p>A few things I’ve built, with details on technology used and why certain decisions were made.</p>
  </div>

  <div class="wrapper region">
    <ul class="project-list not-prose">
      {projects.map((project, index) => (
        <ProjectCard project={project} priority={index < 3} />
      ))}
    </ul>
  </div>

  <div class="region"></div>
</BaseLayout>
