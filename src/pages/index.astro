---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoIconLight from '../assets/logo-amber-large.svg?raw';
import Contour from '../components/contour/Contour.astro';
import { siteData } from '../data/site-data';
import ProjectCard from '../components/core/ProjectCard.astro';
import PhotoGrid from '../components/photography/PhotoGrid.astro';
import { getProject } from '../data/projects';
import { featuredPhotoSlugs } from '../data/photos';
import { getPhotos } from '../utils/photos';

const featuredProject = getProject('key-creative-management');
const allPhotos = await getPhotos();
const featuredPhotos = featuredPhotoSlugs
  .map((slug) => allPhotos.find((photo) => photo.slug === slug))
  .filter((photo) => photo !== undefined);
---

<BaseLayout
  title="Sam Young | Developer, Designer, Artist"
  description="Sam Young’s digital garden, a Nashville-based full-stack software engineer, designer, and artist."
>
  <div class="home">
    <Contour />

    <div class="hero-content-container">
      <div class="hero-content" data-motion="stagger">
        <h1 class="hero-content__heading">
          <span class="hero-content__icon" set:html={LogoIconLight} />
          Sam Young
        </h1>
        <p style="--i: 1">Developer</p>
        <p style="--i: 2">Designer</p>
        <p style="--i: 3">Artist</p>
      </div>

      <div class="content region prose prose-w-sm flow">
        <h2>Howdy!</h2>
        <p>I’m a software engineer that also has a knack for design, currently based out of Nashville, TN. I am very interested in the intersection of where design meets code.</p>
      </div>
    </div>

    <section class="region wrapper flow" aria-labelledby="featured-project">
      <div class="repel">
        <h2 id="featured-project">Featured project</h2>
        <a href="/projects/" class="button" data-button-variant="border">All projects</a>
      </div>
      {featuredProject && (
        <ul class="project-list not-prose" data-list-layout="feature">
          <ProjectCard project={featuredProject} layout="feature" headingLevel={3} />
        </ul>
      )}
    </section>

    <section class="region wrapper flow" aria-labelledby="featured-photos">
      <div class="repel">
        <h2 id="featured-photos">Photography</h2>
        <a href="/photography/" class="button" data-button-variant="border">All photos</a>
      </div>
      <PhotoGrid photos={featuredPhotos} priority={false} />
    </section>

    <div class="region wrapper prose prose-w-sm flow">
      <h2>Contact</h2>
      <p>I am reachable through <a href={`mailto:${siteData.email}`}>email</a>. You can also view or download my <a href="/resume">resume</a>.</p>
    </div>
  </div>
</BaseLayout>
