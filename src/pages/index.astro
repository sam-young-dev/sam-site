---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoIcon from '../assets/logo-amber-large.svg?raw';
---

<BaseLayout
  title="Sam Young — Developer, Designer, Artist"
  description="Sam Young's digital garden — a Nashville-based full-stack software engineer, designer, and artist."
>
  <div class="home">
    <div id="puddle-container"></div>

    <div class="hero-content-container">
      <div class="hero-content hero-content--stagger">
        <h1 class="hero-content__heading">
          <span class="hero-content__icon" set:html={LogoIcon} />
          Sam Young
        </h1>
        <p>Developer</p>
        <p>Designer</p>
        <p>Artist</p>
      </div>

      <div class="content region prose flow">
        <h2>Howdy!</h2>
        <p>I'm a software engineer that also has a knack for design, currently based out of Nashville, TN. I am really into the intersection of where design meets code.</p>
      </div>
    </div>

    <div class="region wrapper prose flow">
      <h2>Explore the Site!</h2>
      <ul class="explore-list not-prose">
        <li><a href="/photography">Photography</a></li>
        <li><a href="/art">Art</a></li>
        <li><a href="/projects">Projects</a></li>
      </ul>
    </div>

    <div class="region wrapper prose flow">
      <h2>Contact</h2>
      <p>I am reachable through <a href="mailto:sam.young@email.com">email</a>. You can also view my resume <a href="/resume">here</a>.</p>
    </div>
  </div>
</BaseLayout>

<script>
	import '../lib/puddle.js';
</script>
