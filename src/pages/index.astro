---
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/masthead/Masthead.astro';
import Hero from '../components/hero/Hero.astro';
import Closer from '../components/closer/Closer.astro';
---

<BaseLayout>
  <div id="puddle-container"></div>

  <div class="reasonable-width">
		<div class="hero-about hero-about--stagger wrapper">
			<h1>Sam Young</h1>
			<p>Developer</p>
			<p>Designer</p>
			<p>Artist</p>
		</div>

    <div class="content region wrapper">
      <section class="readable prose">
        <h2>Howdy!</h2>
        <p>I'm Sam Young; here is my digital garden that is a constant work in progress and changing over time.</p>
      </section>
    </div>
	</div>

	<div class="region wrapper">
		<h2>Explore the site!</h2>
		<ul>
			<li><a href="/photography">Photography</a></li>
		</ul>
	</div>

	<Closer />
</BaseLayout>

<script>
	import '../lib/puddle.js';
</script>
