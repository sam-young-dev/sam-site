---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoIcon from '../assets/logo-amber-large.svg?raw';
---

<BaseLayout>
  <div id="puddle-container"></div>

  <div class="hero-content-container">
		<div class="hero-content hero-content--stagger wrapper">
			<h1 class="hero-content__heading">
				<span class="hero-content__icon" set:html={LogoIcon} />
				Sam Young
			</h1>
			<p>Developer</p>
			<p>Designer</p>
			<p>Artist</p>
		</div>

    <div class="content region wrapper">
      <section class="prose">
        <h2>Howdy!</h2>
        <p>I'm Sam Young; here is my digital garden that is a constant work in progress and changing over time.</p>
      </section>
    </div>
	</div>

	<div class="region wrapper">
		<h2>Explore the site!</h2>
		<ul>
			<li><a href="/photography">Photography</a></li>
			<li><a href="/art">Art</a></li>
			<li><a href="/projects">Projects</a></li>
		</ul>
	</div>
</BaseLayout>

<script>
	import '../lib/puddle.js';
</script>
