---
import LogoIcon from '../../assets/logo-amber-large.svg?raw';
import { siteData } from '../../data/site-data';

const isHome = Astro.url.pathname === '/';

const isCurrent = (href: string) =>
  Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);
---

<header class:list={['site-head', { 'site-head--home': isHome }]}>
  <div class="wrapper">
    <div class="repel site-head__inner">
      <div class="site-head__brand">
        <a href="/" class="site-head__brand-link">
          <span class="site-head__brand-icon" set:html={LogoIcon} />
          <span class="visually-hidden">{siteData.title} home</span>
        </a>
      </div>
      <nav aria-label="primary" class="nav">
        <ul class="cluster" role="list">
          {siteData.navItems.map((item) => (
          <li>
            <a href={item.href} {...(isCurrent(item.href) ? {'aria-current': 'page'} : {})}>{item.label}</a>
          </li>
        ))}
        </ul>
      </nav>
    </div>
  </div>
</header>
