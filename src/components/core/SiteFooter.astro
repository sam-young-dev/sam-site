---
const year = new Date().getFullYear()
import LogoIcon from '../../assets/logo-white-large.svg?raw';
import { siteData } from '../../data/site-data'
---

<footer class="site-foot">
  <div class="wrapper flow">
    {siteData.navItems.length > 0 && (
      <nav aria-label="footer" class="nav">
        <ul class="cluster" role="list">
          {siteData.navItems.map((item) => (
            <li>
              <a href={item.href} {...(item.current ? {'aria-current': 'page'} : {})}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
    <hr/>
    <div class="repel">
      <p class="site-foot__brand">&copy; <span class="site-foot__brand-icon" set:html={LogoIcon} />{siteData.title} <span id="footer-year">{year}</span></p>
      <p>All rights reserved.</p>
    </div>
  </div>
</footer>

<script is:inline>
  document.getElementById("footer-year").innerText = new Date().getFullYear();
</script>