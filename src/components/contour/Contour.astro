---
import { DEFAULTS, FIELDS, KNOBS, PALETTES } from '../../lib/contour-config.js';
---

<div class="contour" data-contour></div>

<details class="contour-panel">
  <summary class="contour-panel__toggle button" data-button-variant="border">Tune</summary>

  <div class="contour-panel__body flow" data-contour-panel>
    <label class="contour-panel__row">
      <span>Field</span>
      <select name="field">
        {Object.entries(FIELDS).map(([value, label]) => (
          <option value={value} selected={value === DEFAULTS.field}>{label}</option>
        ))}
      </select>
    </label>

    <label class="contour-panel__row">
      <span>Palette</span>
      <select name="palette">
        {Object.entries(PALETTES).map(([value, label]) => (
          <option value={value} selected={value === DEFAULTS.palette}>{label}</option>
        ))}
      </select>
    </label>

    {KNOBS.map((knob) => (
      <label class="contour-panel__row">
        <span>{knob.label}</span>
        <input
          type="range"
          name={knob.key}
          min={knob.min}
          max={knob.max}
          step={knob.step}
          value={DEFAULTS[knob.key]}
        />
        <output data-contour-output={knob.key}>{DEFAULTS[knob.key]}</output>
      </label>
    ))}

    <p class="contour-panel__row">
      <span>Seed</span>
      <output data-contour-seed>{DEFAULTS.seed}</output>
    </p>

    <div class="cluster">
      <button type="button" class="button" data-button-variant="border" data-contour-reseed>Reseed</button>
      <button type="button" class="button" data-button-variant="brand" data-contour-copy>
        <span data-contour-copy-label>Copy settings</span>
      </button>
    </div>

    <p class="contour-panel__hint">Click the map for a new composition.</p>
  </div>
</details>

<script>
  import '../../lib/contour.js';
</script>
