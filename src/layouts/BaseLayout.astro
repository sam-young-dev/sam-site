---
import MetaInfo from '../components/core/MetaInfo.astro';
import Header from '../components/core/SiteHeader.astro';
import SiteFooter from '../components/core/SiteFooter.astro';
import { ClientRouter } from 'astro:transitions';

import cabinetGroteskRegular from '../fonts/CabinetGrotesk-Regular.woff2?url';
import cabinetGroteskMedium from '../fonts/CabinetGrotesk-Medium.woff2?url';
import cabinetGroteskBold from '../fonts/CabinetGrotesk-Bold.woff2?url';
import dmMono from '../fonts/dm-mono-v14-latin-500.woff2?url';

import "virtual:sugarcube.css";
import "../styles/index.css";

const {
  title = "Sam Young | Developer, Designer, Artist",
  description = "Personal site of Sam Young, a Nashville-based full-stack software engineer working in React, Angular, Astro, and .NET.",
  socialImage = "/og.png",
  allowRobots,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preload" as="font" type="font/woff2" href={cabinetGroteskRegular} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={cabinetGroteskMedium} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={cabinetGroteskBold} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={dmMono} crossorigin />
    <MetaInfo
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      socialImage={socialImage}
      allowRobots={allowRobots}
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main tabindex="-1" id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script is:inline>
      // Images that finished loading before their onload handler could run (cache hits, router swaps) would stay hidden.
      document.addEventListener("astro:page-load", function () {
        document.querySelectorAll("img").forEach(function (img) {
          if (img.complete) img.dataset.state = "loaded";
        });
      });
    </script>
  </body>
</html>
